# Mantiene LF per tutti i file di testo (standard GitHub)
* text=auto eol=lf

# File specifici che devono SEMPRE essere LF
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mmd text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Evita conversioni o diff inutili
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary

# Database e file generati
*.db binary
*.sqlite binary
*.pkl binary
*.pickle binary

# Mermaid diagrams
*.mmd text eol=lf

# Bytecode Python
*.pyc binary
__pycache__/ binary